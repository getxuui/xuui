{
  "name": "@getxuui/xuui",
  "version": "0.1.0-alpha.6",
  "description": "Review the UIs your agents build: compare variants on a local canvas and send comments back to the agent. Experimental alpha.",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "dev": "vite",
    "mcp": "node src/xuui/mcp.ts",
    "mcp:setup": "node scripts/setup-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build-package.mjs",
    "test": "playwright test",
    "check": "npm run build && npm test && npm run test:package",
    "build:demo": "vite build --outDir demo-dist",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ui",
    "react",
    "design",
    "variants",
    "agents",
    "mcp"
  ],
  "author": "Robin Humphreys",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "agentation": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "react-resizable-panels": "^4.15.3",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "rolldown": "^1.2.16",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  },
  "license": "MIT",
  "homepage": "https://xuui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getxuui/xuui.git"
  },
  "bugs": {
    "url": "https://github.com/getxuui/xuui/issues"
  },
  "bin": {
    "xuui": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./studio": "./dist/studio/studio.js",
    "./styles.css": "./dist/studio/studio.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/authoring.md",
    "docs/controls.md",
    "docs/mcp.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
